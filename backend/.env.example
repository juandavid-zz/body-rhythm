# Copia este archivo como .env y completa tus valores

# Base de datos (MySQL / MariaDB de XAMPP)
DB_NAME=body_rhythm
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Solo en la nube: ruta al certificado SSL del proveedor de la base (ej. ca.pem de Aiven)
DB_SSL_CA=

# En producción: una clave larga y aleatoria (con DEBUG=False la app no arranca sin ella)
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-esto
DEBUG=True

# Opcional: listas separadas por comas. Si se dejan vacías se usan las de desarrollo local.
# Ej.: ALLOWED_HOSTS=localhost,127.0.0.1,mi-tunel.trycloudflare.com
ALLOWED_HOSTS=
# Ej.: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://mi-frontend.com
CORS_ALLOWED_ORIGINS=

# IA del chatbot
GEMINI_API_KEY=
# Vacío = Flash-Lite (más cupo gratis). Con facturación: gemini-flash-latest
GEMINI_MODELO_CHAT=

# Correo con Brevo (recomendado en Render: su plan gratis bloquea el SMTP de Gmail).
# Crea la clave en Brevo > SMTP & API > API Keys y verifica tu correo como remitente;
# ese correo va en DEFAULT_FROM_EMAIL. Si está, se usa en vez de Gmail.
BREVO_API_KEY=

# Correo de verificación (Gmail)
# EMAIL_HOST_PASSWORD es una "contraseña de aplicación" de Google, NO la contraseña normal:
# https://myaccount.google.com/apppasswords (requiere verificación en dos pasos activada)
# Si se dejan vacíos, los correos solo se imprimen en la consola del backend.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Solo pruebas locales sin Gmail: True muestra en pantalla el enlace para verificar
# la cuenta (cualquiera podría verificar cualquier correo). No tiene efecto si
# DEBUG=False o si EMAIL_HOST_USER/EMAIL_HOST_PASSWORD están configurados.
MOSTRAR_ENLACE_VERIFICACION=False

# Pagos con Wompi (llaves del panel de Wompi; usa las de pruebas en desarrollo)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Pruebas: https://sandbox.wompi.co/v1 · Producción: https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1

# Límites de uso de la IA por usuario (cada llamada a Gemini cuesta)
LIMITE_IA_RUTINAS=20/hour
LIMITE_IA_CHAT=60/hour

# Fotos de perfil en Cloudinary (obligatorio en Render: su disco se borra al reiniciar).
# Copia el "API environment variable" del panel de Cloudinary: cloudinary://clave:secreto@nube
# Vacío = se guardan en la carpeta media/ (desarrollo local)
CLOUDINARY_URL=

# URL del frontend para el enlace del correo
FRONTEND_URL=http://localhost:5173

# ── Solo producción (DEBUG=False) ──
# Dominios del frontend que envían formularios, con https:// (ej. https://bodyrhythm.app)
CSRF_TRUSTED_ORIGINS=
# Redirige http a https (pon False si tu proveedor ya lo hace y ves redirecciones infinitas)
SECURE_SSL_REDIRECT=True
# HSTS en segundos: déjalo en 0 hasta confirmar que todo funciona con HTTPS; luego 31536000
SECURE_HSTS_SECONDS=0
# True si no hay Nginx u otro servidor que sirva las fotos de perfil (carpeta media/)
SERVIR_MEDIA=False
# Nivel de los registros del proyecto: DEBUG, INFO, WARNING o ERROR
NIVEL_LOGS=INFO
