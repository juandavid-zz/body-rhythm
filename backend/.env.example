# Copia este archivo como .env y completa tus valores

# Base de datos (MySQL / MariaDB de XAMPP)
DB_NAME=body_rhythm
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

SECRET_KEY=cambia-esto
DEBUG=True

# Opcional: listas separadas por comas. Si se dejan vacías se usan las de desarrollo local.
# Ej.: ALLOWED_HOSTS=localhost,127.0.0.1,mi-tunel.trycloudflare.com
ALLOWED_HOSTS=
# Ej.: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://mi-frontend.com
CORS_ALLOWED_ORIGINS=

# IA del chatbot
GEMINI_API_KEY=

# Correo de verificación (Gmail)
# EMAIL_HOST_PASSWORD es una "contraseña de aplicación" de Google, NO la contraseña normal:
# https://myaccount.google.com/apppasswords (requiere verificación en dos pasos activada)
# Si se dejan vacíos, los correos solo se imprimen en la consola del backend.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Solo pruebas locales sin Gmail: True muestra en pantalla el enlace para verificar
# la cuenta (cualquiera podría verificar cualquier correo). No tiene efecto si
# DEBUG=False o si EMAIL_HOST_USER/EMAIL_HOST_PASSWORD están configurados.
MOSTRAR_ENLACE_VERIFICACION=False

# Pagos con Wompi (llaves del panel de Wompi; usa las de pruebas en desarrollo)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# URL del frontend para el enlace del correo
FRONTEND_URL=http://localhost:5173
